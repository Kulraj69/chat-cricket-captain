PORT=3000
VOTE_WINDOW_MS=15000
TARGET=36
MAX_OVERS=3

# Chat (all three are required to leave mock-only mode)
TWITCH_CHANNEL=your_channel
TWITCH_BOT_USERNAME=your_bot_username
TWITCH_OAUTH_TOKEN=oauth:your_bot_oauth_token

# Optional EventSub. This must be a USER token, not an app token.
TWITCH_CLIENT_ID=your_application_client_id
TWITCH_USER_OAUTH_TOKEN=your_user_access_token
# Optional; looked up from TWITCH_CHANNEL when omitted.
TWITCH_BROADCASTER_ID=
TWITCH_MODERATOR_ID=
